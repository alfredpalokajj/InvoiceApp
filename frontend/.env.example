# Optional. When set, maps use Google Maps (Maps JavaScript API + Geocoding API must be enabled).
# When empty, the app uses OpenStreetMap (Leaflet + Nominatim) instead.
VITE_GOOGLE_MAPS_API_KEY=
# Optional Google Maps Map ID for advanced markers. DEMO_MAP_ID works for development.
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
